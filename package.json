{
  "name": "raic-economics",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Interactive AP Microeconomics and AP Macroeconomics visual labs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "check:types": "tsc --noEmit",
    "check:routes": "node scripts/validate-route-files.mjs",
    "check": "pnpm test && pnpm check:types && pnpm check:routes && pnpm build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "next": "16.1.6",
    "postcss": "8.5.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
